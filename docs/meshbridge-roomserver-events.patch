+// ---------------------------------------------------------------------------
+// Bear Den bridge: structured event lines for the serial bridge daemon.
+// Every event is one ASCII-safe line:  BRIDGE <json>
+// The daemon greps for the "BRIDGE " prefix and ignores everything else
+// (CLI echoes, debug logs, stats output).
+static void bridgeEmit(const char *json) {
+  Serial.print("BRIDGE ");
+  Serial.println(json);
+}
+
+static void bridgeJsonEscape(char *dst, size_t dstSize, const char *src) {
+  size_t o = 0;
+  for (size_t i = 0; src[i] && o + 7 < dstSize; i++) {
+    char c = src[i];
+    if (c == '"' || c == '\\') { dst[o++] = '\\'; dst[o++] = c; }
+    else if ((uint8_t)c < 0x20) { o += snprintf(&dst[o], dstSize - o, "\\u%04x", (uint8_t)c); }
+    else dst[o++] = c;
+  }
+  dst[o] = 0;
+}
+
+static void bridgeKeyHex(char *dst, const uint8_t *key) {
+  for (int i = 0; i < 4; i++) sprintf(&dst[i * 2], "%02X", key[i]);
+  dst[8] = 0;
+}
